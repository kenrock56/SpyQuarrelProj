.root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.39);
    border-left-color: rgba(75, 64, 64, 0.41);
    border-right-color: rgba(75, 64, 64, 0.41);
    border-top-color: rgba(75, 64, 64, 0.41);
    border-bottom-color: rgba(75, 64, 64, 0.41);
    width: 100%;
    height: 100%;
}

.top-bar {
    height: 25%;
    flex-direction: row;
}

.logo-area {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    padding-top: 32px;
    padding-left: 49px;
}

.logo-text {
    color: white;
    font-size: 66px;
    unity-font-style: bold-and-italic;
    unity-text-align: middle-left;
    letter-spacing: 12px;
}

.menu-area {
    height: 50%;
    flex-direction: row;
}

.menu-panel {
    width: 49%;
    margin-left: 40px;
    justify-content: flex-start;
    align-items: flex-start;
}

.main-button {
    width: 100%;
    height: 20%;
    margin-top: 8px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
    font-size: 495%;
    color: white;
    unity-text-align: upper-left;
    transition-duration: 0.2s;
    -unity-text-align: upper-left;
    -unity-font-style: bold;
}

.main-button:hover {
    -unity-text-outline-color: black;
    -unity-text-outline-width: 2px;
    font-size: 55px;
    letter-spacing: 8px;
    unity-text-align: middle-left;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    max-width: 90%;
}

.main-button:active {
    transition-duration: 0.1s;
    rotate: -1deg;
    transform-origin: left top;
}

.bottom {
    flex-grow: 1;
}

OptionCardElement {
    width: 20%;
    min-width: 10%;
}
